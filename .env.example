# Скопируйте этот файл в .env и заполните своими значениями.
# Значения секретов вписывайте ТОЛЬКО вручную в .env — этот файл в Git не попадает,
# а .env находится в .gitignore.

# ===== GigaChat API =====
# Authorization Key из личного кабинета Studio: проект GigaChat API ->
# Настройки API -> Получить ключ. Ключ живёт только на сервере, в браузер не попадает.
GIGACHAT_AUTH_KEY=
# Режим доступа: GIGACHAT_API_PERS (физлица), GIGACHAT_API_B2B, GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Используемая модель
GIGACHAT_MODEL=GigaChat-2-Pro
# Необязательные адреса (менять только при необходимости)
#GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
#GIGACHAT_API_URL=https://api.giga.chat/v1/chat/completions
# Корневой сертификат НУЦ Минцифры (по умолчанию certs/russian_trusted_root_ca_pem.crt)
#GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca_pem.crt

# ===== Доступ рекрутёра =====
# Токен для чтения/правки/удаления кандидатов (заголовок Authorization: Bearer).
# Сгенерируйте длинную случайную строку и никому не передавайте:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_TOKEN=

# ===== Сервер (src/server.js) =====
# Слушать только localhost (по умолчанию); 0.0.0.0 — только за reverse-proxy и TLS
HOST=127.0.0.1
PORT=3000
# Лимит запросов в минуту на POST /api/extract и POST /api/candidates
RATE_LIMIT_MAX=10
# Файл базы кандидатов (по умолчанию ./candidates.json)
#CANDIDATES_FILE=candidates.json

# ===== Нативный TLS (опционально) =====
# PEM-файлы сертификата и ключа — сервер поднимется по https.
# Без них — http; на публичном контуре TLS терминирует reverse-proxy
# (см. docs/ПРОМЫШЛЕННАЯ.md)
#TLS_CERT_FILE=certs/server.crt
#TLS_KEY_FILE=certs/server.key
