# Скопируйте этот файл в .env и заполните своими значениями.
# Значения секретов вписывайте ТОЛЬКО вручную в .env — этот файл в Git не попадает.

# ===== ВКонтакте: сообщество =====
# Ключ доступа сообщества (Управление сообществом -> Работа с API).
# Обязательно с правом "messages" и включённым Long Poll API.
VK_GROUP_TOKEN=
# ID сообщества (виден в адресе страницы или в настройках сообщества)
VK_GROUP_ID=
# Версия VK API
VK_API_VERSION=5.199

# ===== GigaChat API =====
# Authorization Key из личного кабинета Studio: проект GigaChat API -> Настройки API -> Получить ключ
GIGACHAT_AUTH_KEY=
# Режим доступа: GIGACHAT_API_PERS (физлица), GIGACHAT_API_B2B, GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Используемая модель
GIGACHAT_MODEL=GigaChat-2-Pro
# Необязательные адреса (менять только при необходимости)
#GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
#GIGACHAT_API_URL=https://api.giga.chat/v1/chat/completions
#GIGACHAT_CA_BUNDLE=certs/russian_trusted_bundle.pem

# ===== Диалог =====
# Сколько последних реплик (пар вопрос/ответ) помнит бот на собеседника
DIALOG_HISTORY_LIMIT=10
# Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ===== Продажи =====
# Ссылка на форму для связи с отделом продаж Zerocoder, которую предлагает Алина
SALES_FORM_URL=

# ===== ПроКадры: сервер (server.js) =====
# Токен рекрутёра для чтения/правки/удаления кандидатов (Bearer).
# Сгенерируйте длинную случайную строку и никому не передавайте.
APP_TOKEN=
# Слушать только localhost (по умолчанию); 0.0.0.0 — только за reverse-proxy
HOST=127.0.0.1
PORT=3000
# Лимит запросов в минуту на ручки извлечения и создания кандидата
RATE_LIMIT_MAX=10
# Файл базы кандидатов (по умолчанию ./candidates.json)
#CANDIDATES_FILE=candidates.json
# Нативный TLS: PEM-файлы сертификата и ключа — сервер поднимется по https.
# Без них — http; на публичном контуре TLS терминирует reverse-proxy
# (см. Documents/ПРОМЫШЛЕННАЯ.md)
#TLS_CERT_FILE=certs/server.crt
#TLS_KEY_FILE=certs/server.key
