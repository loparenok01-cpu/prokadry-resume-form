{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      ".env.example*": "allow",
      "**/.env.example*": "allow",
      ".temp/**": "allow"
    },
    "edit": {
      "*": "ask",
      ".temp/**": "allow"
    },
    "task": "ask",
    "skill": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "node --check script.js": "allow",
      "node --check server.js": "allow",
      "rm *": "deny"
    }
  }
}
